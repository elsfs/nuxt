# 应用标题
NUXT_PUBLIC_APP_TITLE=Vben Admin Ele Nuxt

# 应用命名空间，用于缓存、store等功能的前缀，确保隔离
NUXT_PUBLIC_APP_NAMESPACE=vben-web-ele-nuxt

# 对store进行加密的密钥，在将store持久化到localStorage时会使用该密钥进行加密
VITE_APP_STORE_SECURE_KEY=please-replace-me-with-your-own-key

# 供 @vben/* 内部包通过 import.meta.env 读取
VITE_APP_TITLE=Vben Admin Ele Nuxt
VITE_APP_NAMESPACE=vben-web-ele-nuxt